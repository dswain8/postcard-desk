# deps & build
node_modules
dist
.vite
tsconfig.tsbuildinfo

# stray compiled .js next to .ts sources (Vite handles TS directly)
src/**/*.js
vite-plugins/**/*.js

# os
.DS_Store
*.log

# personal data — only the fictional seeds under data/seed/ are checked in.
# your real Slack / Jira / GitHub / Calendar / Drive snapshots stay local.
data/*.json

# local agent runtime — queued jobs, drafts, budget ledgers, and logs stay local.
agent/*.jsonl
agent/*.lock
agent/*.log
agent/config.json
agent/runs/
agent/drafts/
agent/budget/
agent/jobs/

# editor / local-only
.claude/
.vscode/
.idea/

# local refresh script — copy scripts/refresh.sh here and edit your placeholders
scripts/refresh.local.sh
.vercel
